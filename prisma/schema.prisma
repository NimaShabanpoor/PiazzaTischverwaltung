// Piazza 106 – Tischreservierungssystem
// Prisma Schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// Maximal 4 Tische. Der Status hier ist der manuell gesetzte Grundzustand
/// (FREI = normal, wird automatisch als "Reserviert" angezeigt sobald eine
/// Reservation den aktuellen Zeitraum abdeckt). BESETZT und GESPERRT werden
/// vom Chef aktiv gesetzt und überschreiben die automatische Anzeige.
/// BESETZT ist zeitlich begrenzt (busyFrom/busyUntil) – nach Ablauf zeigt
/// der Tisch automatisch wieder seinen normalen Status (z.B. am nächsten
/// Morgen wieder frei/buchbar), ohne dass der Chef ihn manuell freigeben muss.
model Table {
  id         String        @id @default(cuid())
  number     Int           @unique
  seats      Int
  active     Boolean       @default(true)
  status     TableStatus   @default(FREI)
  lockNote   String?
  busyFrom   DateTime?
  busyUntil  DateTime?
  reservations Reservation[]
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@map("tables")
}

enum TableStatus {
  FREI
  BESETZT
  GESPERRT
}

model Reservation {
  id               String            @id @default(cuid())
  confirmationCode String            @unique @default(cuid())
  tableId          String
  table            Table             @relation(fields: [tableId], references: [id], onDelete: Cascade)
  start            DateTime
  end              DateTime
  partySize        Int
  customerName     String
  customerPhone    String
  customerEmail    String
  status           ReservationStatus @default(CONFIRMED)
  source           ReservationSource @default(ONLINE)
  note             String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([tableId, start, end])
  @@index([start])
  @@map("reservations")
}

enum ReservationStatus {
  CONFIRMED
  ARRIVED
  CANCELLED
  COMPLETED
}

enum ReservationSource {
  ONLINE
  PHONE
}

/// Gruppen über der Online-Grenze (MAX_ONLINE_PARTY_SIZE) können nicht direkt
/// buchen, sondern senden eine Anfrage, die der Chef im Admin-Bereich bearbeitet.
model GroupRequest {
  id            String             @id @default(cuid())
  start         DateTime
  end           DateTime
  partySize     Int
  customerName  String
  customerPhone String
  customerEmail String
  note          String?
  status        GroupRequestStatus @default(OFFEN)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([status, start])
  @@map("group_requests")
}

enum GroupRequestStatus {
  OFFEN
  ANGENOMMEN
  ABGELEHNT
}

model AdminUser {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("admin_users")
}

/// Einzelne Tage, an denen das Restaurant geschlossen ist (Ferien, Feiertage).
/// `date` ist ein reines Kalenderdatum als "YYYY-MM-DD" – dadurch sind keine
/// Zeitzonen-Umrechnungen noetig.
model ClosedDay {
  id        String   @id @default(cuid())
  date      String   @unique
  reason    String?
  createdAt DateTime @default(now())

  @@map("closed_days")
}
